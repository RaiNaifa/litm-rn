{
	"$schema": "https://json.schemastore.org/foundryvtt-system-manifest.json",
	"id": "litm-rn",
	"version": "11.1.1",
	"license": "LICENSE",
	"title": "Legend in the Mist (RN)",
	"description": "A <strong>Rustic Fantasy</strong> Game for Foundry Virtual Tabletop.",
	"url": "https://github.com/RaiNaifa/litm-rn",
	"manifest": "https://github.com/RaiNaifa/litm-rn/releases/latest/download/system.json",
	"download": "https://github.com/RaiNaifa/litm-rn/releases/download/v11.1.1/litm-rn.zip",
	"authors": [
		{
			"name": "RaiNaifa",
			"discord": "rainaifa"
		}
	],
	"esmodules": ["litm-rn.js"],
	"styles": ["litm-rn.css"],
	"documentTypes": {
		"Actor": {
			"character": {
				"htmlFields": ["note"]
			},
			"challenge": {
				"htmlFields": ["note", "special"]
			}
		},
		"Item": {
			"backpack": {},
			"fellowship": {
				"htmlFields": ["note"]
			},
			"hero": {},
			"story": {
				"htmlFields": ["note"]
			},
			"theme": {},
			"themebook": {
				"htmlFields": ["description"]
			},
			"themekit": {
				"htmlFields": ["description"]
			},
			"trope": {
				"htmlFields": ["description"]
			},
			"threat": {}
		}
	},
	"languages": [
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		},
		{
			"lang": "ru",
			"name": "Russian",
			"path": "lang/ru.json"
		}
	],
	"socket": true,
	"compatibility": {
		"minimum": 13,
		"verified": 14,
		"maximum": 14
	},
	"flags": {
		"hotReload": {
			"extensions": ["css", "html", "js", "json"],
			"paths": ["styles", "templates", "lang", "litm.css", "litm.js"]
		}
	},
	"relationships": {
		"recommends": [
			{
				"id": "dice-so-nice",
				"manifest": "https://gitlab.com/riccisi/foundryvtt-dice-so-nice/-/raw/master/module/module.json"
			}
		]
	},
	"background": "systems/litm-rn/assets/media/litm-custom-logo.webp"
}
