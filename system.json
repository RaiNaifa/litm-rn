{
	"$schema": "https://json.schemastore.org/foundryvtt-system-manifest.json",
	"id": "litm-rn",
	"version": 10.9,
	"license": "LICENSE",
	"title": "Legend in the Mist",
	"description": "A <strong>Rustic Fantasy</strong> Game for Foundry Virtual Tabletop.",
	"authors": [
		{
			"name": "Filip Ambrosius",
			"discord": "aMediocreDad#2483",
			"email": "hello@amediocre.dev",
			"ko-fi": "amediocredad"
		},
		{
			"name": "RaiNaifa",
			"discord": "rainaifa"
		}
	],
	"esmodules": [
		"litm-rn.js"
	],
	"styles": [
		"litm-rn.css"
	],
	"documentTypes": {
		"Actor": {
			"character": {
				"htmlFields": [
					"note"
				]
			},
			"challenge": {
				"htmlFields": [
					"note",
					"special"
				]
			}
		},
		"Item": {
			"backpack": {},
			"fellowship": {
				"htmlFields": [
					"note"
				]
			},
			"hero": {},
			"story": {
				"htmlFields": [
					"note"
				]
			},
			"theme": {
				"htmlFields": [
					"note"
				]
			},
			"threat": {}
		}
	},
	"languages": [
		{
			"lang": "cn",
			"name": "中文",
			"path": "lang/cn.json"
		},
		{
			"lang": "de",
			"name": "Deutsch",
			"path": "lang/de.json"
		},
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		},
		{
			"lang": "es",
			"name": "Español",
			"path": "lang/es.json"
		},
		{
			"lang": "no",
			"name": "Norsk",
			"path": "lang/no.json"
		},
		{
			"lang": "ru",
			"name": "Russian",
			"path": "lang/ru.json"
		}
	],
	"socket": true,
	"compatibility": {
		"minimum": 12,
		"verified": 13,
		"maximum": 13
	},
	"flags": {
		"hotReload": {
			"extensions": [
				"css",
				"html",
				"js",
				"json"
			],
			"paths": [
				"styles",
				"templates",
				"lang",
				"litm.css",
				"litm.js"
			]
		}
	},
	"relationships": {
		"recommends": [
			{
				"id": "dice-so-nice",
				"manifest": "https://gitlab.com/riccisi/foundryvtt-dice-so-nice/-/raw/master/module/module.json"
			}
		]
	},
	"background": "systems/litm-rn/assets/media/litm_splash.webp"
}
